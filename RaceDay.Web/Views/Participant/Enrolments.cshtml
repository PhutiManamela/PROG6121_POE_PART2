@model MyEnrolmentsViewModel
@{ ViewData["Title"] = "My enrolments"; }
<h1 class="h3 mb-3">My enrolments</h1>
<h2 class="h5">Active</h2>
@if (Model.Active.Count == 0)
{
    <div class="alert alert-info">You aren't enrolled in any upcoming races. <a asp-controller="Races" asp-action="Index">Browse races</a>.</div>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded mb-4">
    <table class="table align-middle mb-0">
        <thead><tr><th>Event</th><th>Category</th><th>Date</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Active)
        {
            <tr>
                <td><a asp-controller="Races" asp-action="Details" asp-route-id="@r.Enrolment.EventId">@r.Enrolment.EventName</a></td>
                <td>@r.Enrolment.CategoryName</td>
                <td>@(r.EventDate?.ToString("d MMM yyyy") ?? "-")</td>
                <td><partial name="_StatusBadge" model="r.Enrolment.Status" /></td>
                <td class="text-end">
                    @if (!r.Enrolment.HasResult)
                    {
                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                            <input type="hidden" name="enrolmentId" value="@r.Enrolment.EnrolmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
<h2 class="h5">Past &amp; cancelled</h2>
@if (Model.Past.Count == 0)
{
    <p class="text-muted">Nothing here yet.</p>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded">
    <table class="table mb-0">
        <thead><tr><th>Event</th><th>Category</th><th>Date</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Past)
        {
            <tr><td>@r.Enrolment.EventName</td><td>@r.Enrolment.CategoryName</td><td>@(r.EventDate?.ToString("d MMM yyyy") ?? "-")</td><td><partial name="_StatusBadge" model="r.Enrolment.Status" /></td></tr>
        }
        </tbody>
    </table>
    </div>
}
