@model List<EventRow>
<div class="table-responsive bg-white shadow-sm rounded">
<table class="table align-middle mb-0">
    <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Participants</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td><a asp-controller="Races" asp-action="Details" asp-route-id="@r.Event.EventId">@r.Event.Name</a><div class="text-muted small">@r.Event.Location</div></td>
            <td>@r.Event.EventDate.ToString("d MMM yyyy")</td>
            <td><span class="badge bg-primary">@r.Event.EventType</span></td>
            <td>@r.Participants</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-eventId="@r.Event.EventId">Categories</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Participants" asp-route-eventId="@r.Event.EventId">Participants</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Results" asp-route-eventId="@r.Event.EventId">Results</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@r.Event.EventId">Edit</a>
                <form asp-action="DeleteEvent" asp-route-id="@r.Event.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
