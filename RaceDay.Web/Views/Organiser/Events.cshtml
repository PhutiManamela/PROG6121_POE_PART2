@model List<EventRow>
@{ ViewData["Title"] = "My events"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My events</h1>
    <a class="btn btn-primary" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a>
</div>
@if (Model.Count == 0) { <div class="alert alert-info">You haven't created any events yet.</div> }
else { <partial name="_EventTable" model="Model" /> }
