@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<h1 class="h3 mb-4">Organiser dashboard</h1>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card rd-stat shadow-sm border-0"><div class="card-body"><div class="text-muted small">Events hosted</div><div class="display-6">@Model.HostedEvents</div></div></div></div>
    <div class="col-md-4"><div class="card rd-stat shadow-sm border-0"><div class="card-body"><div class="text-muted small">Upcoming events</div><div class="display-6">@Model.UpcomingEvents</div></div></div></div>
    <div class="col-md-4"><div class="card rd-stat shadow-sm border-0"><div class="card-body"><div class="text-muted small">Total participants</div><div class="display-6">@Model.TotalParticipants</div></div></div></div>
</div>
@if (Model.NextEvent is not null)
{
    <div class="alert alert-primary">Next up: <strong>@Model.NextEvent.Name</strong> on @Model.NextEvent.EventDate.ToString("d MMM yyyy") at @Model.NextEvent.Location.</div>
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Your events</h2>
    <a class="btn btn-primary btn-sm" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a>
</div>
@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <partial name="_EventTable" model="Model.Rows" />
}
