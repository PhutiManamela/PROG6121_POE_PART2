@model EventDetail
@{ ViewData["Title"] = "Categories"; }
<a asp-action="Events" class="text-decoration-none">&larr; My events</a>
<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">@Model.Name <small class="text-muted">categories</small></h1>
    <a class="btn btn-primary" asp-action="CreateCategory" asp-route-eventId="@Model.EventId"><i class="bi bi-plus-lg"></i> Add category</a>
</div>
@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">No categories yet. Add one so participants can enrol.</div>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded">
    <table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Distance</th><th>Limit</th><th>Entry fee</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model.Categories)
        {
            <tr>
                <td>@c.Name</td><td>@c.DistanceKm.ToString("0.##") km</td><td>@c.MaxParticipants</td>
                <td>@(c.EntryFee == 0 ? "Free" : "R " + c.EntryFee.ToString("0.00"))</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="EditCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.EventId">Edit</a>
                    <form asp-action="DeleteCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.EventId" method="post" class="d-inline" onsubmit="return confirm('Remove this category?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
